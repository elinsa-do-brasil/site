# =============================================================================
# URLs da aplicação
# =============================================================================
# URL base usada pelo Better Auth (callbacks, cookies) e como fallback interno.
NEXT_PUBLIC_URL=http://localhost:3000
# URL pública canônica do site (usada em metadata, sitemap, links absolutos).
NEXT_PUBLIC_SITE_URL=https://elinsadobrasil.com.br

# =============================================================================
# Autenticação (Better Auth) + SSO Microsoft
# =============================================================================
# Segredo usado pelo Better Auth para assinar sessões/tokens. Gere um valor
# aleatório forte (ex.: `openssl rand -base64 32`) e nunca reutilize entre ambientes.
BETTER_AUTH_SECRET=
# Precisa bater com a URL pública onde a aplicação (e o Better Auth) roda.
BETTER_AUTH_URL=http://localhost:3000
# Origens confiáveis para o Better Auth aceitar (CSRF/callback), separadas por vírgula.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Credenciais do App Registration no Azure AD/Entra ID usado para o login SSO.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Domínio de e-mail exigido para permitir login via Microsoft SSO.
MICROSOFT_ALLOWED_DOMAIN=grupoamperelinsa.com

# =============================================================================
# E-mail transacional (Resend)
# =============================================================================
RESEND_API_KEY=
# Remetente usado nos e-mails de autenticação (magic link, reset de senha etc.).
AUTH_EMAIL_FROM="Portal Elinsa <portal@elinsadobrasil.com.br>"
# Endereço de "responder para" opcional nos e-mails de autenticação.
AUTH_EMAIL_REPLY_TO=

# =============================================================================
# Banco de dados (Postgres via Drizzle)
# =============================================================================
# Banco do site institucional (formulário de contato, denúncias, atendimento psicológico).
SITE_DATABASE_URL=
# Banco do CMS (Payload).
CMS_DATABASE_URL=

# =============================================================================
# CMS (Payload)
# =============================================================================
# Segredo interno do Payload (criptografia de sessões/preferences do admin).
PAYLOAD_SECRET=
# Se "true", aplica o schema do Payload direto no banco (`db push`) em vez de
# exigir migrations geradas — usar apenas em dev, nunca em produção.
PAYLOAD_DB_PUSH=false

# =============================================================================
# Formulário de contato (site público)
# =============================================================================
# Destinatário e remetente dos e-mails de notificação de novo contato.
CONTACT_FORM_TO_EMAIL=
CONTACT_FORM_FROM_EMAIL="Site Elinsa <noreply@seudominio.com>"
# Limite de envios e janela (em minutos) do rate limit do formulário público.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
# Chave (base64) usada para hashear o IP do remetente antes de persistir,
# evitando guardar o IP em texto puro. Gere com `openssl rand -base64 32`.
CONTACT_IP_HASH_SECRET_BASE64=

# =============================================================================
# Atendimento psicológico (Amper Cuida)
# =============================================================================
# Chave mestra (base64) usada para criptografar os dados sensíveis dos
# atendimentos armazenados no banco. Gere com `openssl rand -base64 32`.
PSYCHOLOGICAL_CARE_MASTER_KEY_BASE64=
# Destinatário e remetente dos e-mails de notificação de novo atendimento.
PSYCHOLOGICAL_CARE_NOTIFICATION_TO_EMAIL=
PSYCHOLOGICAL_CARE_NOTIFICATION_FROM_EMAIL="Portal Elinsa <noreply@seudominio.com>"
# Limite de envios e janela (em minutos) do rate limit do formulário público.
PSYCHOLOGICAL_CARE_PUBLIC_RATE_LIMIT_MAX=5
PSYCHOLOGICAL_CARE_PUBLIC_RATE_LIMIT_WINDOW_MINUTES=15

# =============================================================================
# Denúncias (Comitê de Ética)
# =============================================================================
# Par de chaves (base64) para criptografia assimétrica das denúncias: a
# pública fica no client (formulário) e cifra o conteúdo antes do envio; a
# privada fica só no servidor e decifra para leitura pelo comitê. Gere ambas
# com `scripts/generate-report-encryption-keys.ts`.
NEXT_PUBLIC_REPORTS_PUBLIC_KEY_BASE64=
REPORTS_PRIVATE_KEY_BASE64=
# Chave mestra (base64) usada para criptografar os anexos das denúncias.
REPORTS_MASTER_KEY_BASE64=
# Destinatário e remetente dos e-mails de notificação de nova denúncia.
REPORT_NOTIFICATION_TO_EMAIL=
REPORT_NOTIFICATION_FROM_EMAIL="Portal Elinsa <noreply@seudominio.com>"
# Limite de envios e janela (em minutos) do rate limit do formulário público.
REPORTS_PUBLIC_RATE_LIMIT_MAX=5
REPORTS_PUBLIC_RATE_LIMIT_WINDOW_MINUTES=15

# =============================================================================
# Cloudflare Turnstile (captcha anti-spam dos formulários públicos)
# =============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEJhFup4I6_8ayk9
TURNSTILE_SECRET=

# =============================================================================
# Azure Blob Storage
# =============================================================================
# Storage do CMS (mídia do Payload).
CMS_STORAGE_CONNECTION_STRING=
CMS_STORAGE_CONTAINER=cms-media
# Storage dos anexos criptografados de denúncias.
DENUNCIAS_STORAGE_CONNECTION_STRING=
DENUNCIAS_STORAGE_CONTAINER=denuncias-anexos

# =============================================================================
# Bancos de imagens (busca de mídia no admin do Payload)
# =============================================================================
UNSPLASH_APPLICATION_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
PEXELS_API_KEY=
API_KEY_PIXABAY=

# =============================================================================
# Sentry (monitoramento de erros)
# =============================================================================
# DSN server-side e client-side (client precisa ser NEXT_PUBLIC_ para chegar ao browser).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Token usado só em build/CI para o Sentry fazer upload dos source maps.
SENTRY_AUTH_TOKEN=

# =============================================================================
# Diversos
# =============================================================================
# Código de verificação de propriedade do site no Google Search Console.
GOOGLE_SITE_VERIFICATION=
# Data (YYYY-MM-DD) do último acidente, exibida na home. Sem esta variável,
# o componente usa uma data hardcoded de fallback — ver components/homepage/home-data.ts.
ELINSA_LAST_ACCIDENT_DATE=
# Link do vídeo tutorial exibido no site (opcional).
NEXT_PUBLIC_YT_LINK=
# String arbitrária para invalidar cache de assets estáticos entre deploys (opcional).
NEXT_PUBLIC_ASSETS_VERSION=
